# Production settings. Copy to .env on the server and fill in every value.
APP_NAME="Your CRM"
APP_ENV=production
APP_KEY=                          # php artisan key:generate
APP_DEBUG=false                   # never true in production
APP_URL=https://crm.example.com
APP_LOCALE=en

CRM_FORCE_HTTPS=true
TRUSTED_PROXIES=                  # "*" behind a cloud load balancer / Cloudflare
CRM_DEFAULT_TIMEZONE=Asia/Kolkata
CRM_SUPPORT_EMAIL=support@example.com
PLATFORM_ADMIN_EMAILS=you@example.com
CRM_REQUIRE_EMAIL_VERIFICATION=true
CRM_SCHEDULER_RUNS_QUEUE=false    # supervisor runs the queue workers

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330          # longer than the slowest job, so none runs twice

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Backups: encrypted, kept locally and off-site (S3, Cloudflare R2,
# DigitalOcean Spaces or Backblaze B2 all speak the S3 protocol).
BACKUP_ARCHIVE_PASSWORD=          # long random string — store it in your password manager
BACKUP_DISKS=backups,s3
BACKUP_NOTIFY_EMAIL=you@example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=                     # for R2 / Spaces / B2
AWS_USE_PATH_STYLE_ENDPOINT=false

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

VAPID_PUBLIC_KEY=                 # php artisan crm:vapid-keys
VAPID_PRIVATE_KEY=
AI_PROVIDER=gemini                # or anthropic
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=                # only if AI_PROVIDER=anthropic
META_GRAPH_VERSION=v25.0

# Payments (later)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=
